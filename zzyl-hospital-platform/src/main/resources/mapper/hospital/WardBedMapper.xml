<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzyl.hospital.mapper.WardBedMapper">
    
    <resultMap type="WardBed" id="WardBedResult">
        <result property="id"    column="id"    />
        <result property="wardBedNo"    column="ward_bed_no"    />
        <result property="wardBedStatus"    column="ward_bed_status"    />
        <result property="sort"    column="sort"    />
        <result property="wardRoomId"    column="ward_room_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWardBedVo">
        select id, ward_bed_no, ward_bed_status, sort, ward_room_id, create_time, update_time, create_by, update_by, remark from ward_bed
    </sql>

    <select id="selectWardBedList" parameterType="WardBed" resultMap="WardBedResult">
        <include refid="selectWardBedVo"/>
        <where>  
            <if test="wardBedNo != null  and wardBedNo != ''"> and ward_bed_no = #{wardBedNo}</if>
            <if test="wardBedStatus != null "> and ward_bed_status = #{wardBedStatus}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="wardRoomId != null "> and ward_room_id = #{wardRoomId}</if>
        </where>
    </select>
    
    <select id="selectWardBedById" parameterType="Long" resultMap="WardBedResult">
        <include refid="selectWardBedVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertWardBed" parameterType="WardBed" useGeneratedKeys="true" keyProperty="id">
        insert into ward_bed
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="wardBedNo != null">ward_bed_no,</if>
            <if test="wardBedStatus != null">ward_bed_status,</if>
            <if test="sort != null">sort,</if>
            <if test="wardRoomId != null">ward_room_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="wardBedNo != null">#{wardBedNo},</if>
            <if test="wardBedStatus != null">#{wardBedStatus},</if>
            <if test="sort != null">#{sort},</if>
            <if test="wardRoomId != null">#{wardRoomId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateWardBed" parameterType="WardBed">
        update ward_bed
        <trim prefix="SET" suffixOverrides=",">
            <if test="wardBedNo != null">ward_bed_no = #{wardBedNo},</if>
            <if test="wardBedStatus != null">ward_bed_status = #{wardBedStatus},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="wardRoomId != null">ward_room_id = #{wardRoomId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWardBedById" parameterType="Long">
        delete from ward_bed where id = #{id}
    </delete>

    <delete id="deleteWardBedByIds" parameterType="String">
        delete from ward_bed where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>