<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzyl.hospital.mapper.CareLevelMapper">
    
    <resultMap type="CareLevel" id="CareLevelResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="carePlanId"    column="care_plan_id"    />
        <result property="fee"    column="fee"    />
        <result property="status"    column="status"    />
        <result property="description"    column="description"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectCareLevelVo">
        select id, name, care_plan_id, fee, status, description, remark, create_time, update_time, create_by, update_by from care_level
    </sql>

    <select id="selectCareLevelList" parameterType="CareLevel" resultMap="CareLevelResult">
        <include refid="selectCareLevelVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="carePlanId != null "> and care_plan_id = #{carePlanId}</if>
            <if test="fee != null "> and fee = #{fee}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
        </where>
    </select>
    
    <select id="selectCareLevelById" parameterType="Long" resultMap="CareLevelResult">
        <include refid="selectCareLevelVo"/>
        where id = #{id}
    </select>

    <select id="selectCareLevelVoList" resultType="com.zzyl.hospital.vo.CareLevelVo">
        select nl.id, name, care_plan_id, fee, nl.status, description, nl.create_time, nl.create_by, nl.update_by, nl.update_time, np.plan_name planName
        from care_level nl
        join care_plan np on nl.care_plan_id = np.id
        <where>
            <if test="name != null  and name != ''"> and nl.name like concat('%', #{name}, '%')</if>
            <if test="status != null"> and nl.status = #{status}</if>
        </where>
    </select>

    <insert id="insertCareLevel" parameterType="CareLevel" useGeneratedKeys="true" keyProperty="id">
        insert into care_level
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="carePlanId != null">care_plan_id,</if>
            <if test="fee != null">fee,</if>
            <if test="status != null">status,</if>
            <if test="description != null">description,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="carePlanId != null">#{carePlanId},</if>
            <if test="fee != null">#{fee},</if>
            <if test="status != null">#{status},</if>
            <if test="description != null">#{description},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
         </trim>
    </insert>

    <update id="updateCareLevel" parameterType="CareLevel">
        update care_level
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="carePlanId != null">care_plan_id = #{carePlanId},</if>
            <if test="fee != null">fee = #{fee},</if>
            <if test="status != null">status = #{status},</if>
            <if test="description != null">description = #{description},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCareLevelById" parameterType="Long">
        delete from care_level where id = #{id}
    </delete>

    <delete id="deleteCareLevelByIds" parameterType="String">
        delete from care_level where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>