<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzyl.hospital.mapper.WardRoomTypeMapper">
    
    <resultMap type="WardRoomType" id="WardRoomTypeResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="wardBedCount"    column="ward_bed_count"    />
        <result property="price"    column="price"    />
        <result property="introduction"    column="introduction"    />
        <result property="photo"    column="photo"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWardRoomTypeVo">
        select id, name, ward_bed_count, price, introduction, photo, status, create_time, update_time, create_by, update_by, remark from ward_room_type
    </sql>

    <select id="selectWardRoomTypeList" parameterType="WardRoomType" resultMap="WardRoomTypeResult">
        <include refid="selectWardRoomTypeVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="wardBedCount != null "> and ward_bed_count = #{wardBedCount}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="introduction != null  and introduction != ''"> and introduction = #{introduction}</if>
            <if test="photo != null  and photo != ''"> and photo = #{photo}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectWardRoomTypeById" parameterType="Long" resultMap="WardRoomTypeResult">
        <include refid="selectWardRoomTypeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertWardRoomType" parameterType="WardRoomType" useGeneratedKeys="true" keyProperty="id">
        insert into ward_room_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="wardBedCount != null">ward_bed_count,</if>
            <if test="price != null">price,</if>
            <if test="introduction != null">introduction,</if>
            <if test="photo != null">photo,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="wardBedCount != null">#{wardBedCount},</if>
            <if test="price != null">#{price},</if>
            <if test="introduction != null">#{introduction},</if>
            <if test="photo != null">#{photo},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateWardRoomType" parameterType="WardRoomType">
        update ward_room_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="wardBedCount != null">ward_bed_count = #{wardBedCount},</if>
            <if test="price != null">price = #{price},</if>
            <if test="introduction != null">introduction = #{introduction},</if>
            <if test="photo != null">photo = #{photo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWardRoomTypeById" parameterType="Long">
        delete from ward_room_type where id = #{id}
    </delete>

    <delete id="deleteWardRoomTypeByIds" parameterType="String">
        delete from ward_room_type where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>